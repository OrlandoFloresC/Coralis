<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Revisión · {{ title }}</title>
<style>
:root {
  --bg: #f6f5f2; --surface: #ffffff; --text: #1d1d1b; --muted: #6b6a66; --border: #e3e1dc;
  --error: #b42318; --error-bg: #fdecea; --aviso: #9a6700; --aviso-bg: #fff4d6;
  --info-bg: #eef3fb; --accent: #2f5aa8; --score-bg: #ffffff;
  --ok: #1a7f37; --ok-bg: #e6f4ea;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #161615; --surface: #1f1f1d; --text: #ecebe8; --muted: #a3a19c; --border: #33322f;
    --error: #ff8a80; --error-bg: #3a1d1b; --aviso: #f2c14e; --aviso-bg: #362d14;
    --info-bg: #1c2636; --accent: #8fb0ee; --score-bg: #f4f3ef;
    --ok: #6fd08c; --ok-bg: #173323;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
main { max-width: 1200px; margin: 0 auto; padding: 24px 16px 64px; }
h1 { font-size: 1.6rem; margin: 0 0 4px; }
.muted { color: var(--muted); }
.stats { display: flex; gap: 12px; flex-wrap: wrap; margin: 20px 0; }
.stat { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; min-width: 140px; }
.stat b { display: block; font-size: 1.6rem; font-variant-numeric: tabular-nums; }
.stat.error b { color: var(--error); } .stat.aviso b { color: var(--aviso); }
.infos { background: var(--info-bg); border-radius: 10px; padding: 10px 16px; margin-bottom: 16px; }
.infos li { margin: 2px 0; }
.filters { display: flex; gap: 8px; flex-wrap: wrap; margin: 8px 0 20px; }
.filters button { border: 1px solid var(--border); background: var(--surface); color: var(--text);
  padding: 6px 12px; border-radius: 999px; cursor: pointer; font: inherit; }
.filters button[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); font-weight: 600; }
.card { background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--aviso);
  border-radius: 10px; padding: 16px; margin-bottom: 16px; }
.card.error { border-left-color: var(--error); }
.card.ok { border-left-color: var(--ok); }
.badge.ok { background: var(--ok-bg); color: var(--ok); }
.card header { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
.card h2 { font-size: 1.15rem; margin: 0; }
.badge { font-size: .78rem; padding: 2px 8px; border-radius: 999px; font-weight: 600; }
.badge.error { background: var(--error-bg); color: var(--error); }
.badge.aviso { background: var(--aviso-bg); color: var(--aviso); }
.card ul { margin: 8px 0 12px; padding-left: 20px; }
.votes { font-size: .85rem; color: var(--muted); margin: 6px 0; display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
.vote { padding: 1px 8px; border-radius: 999px; background: var(--ok-bg); color: var(--ok); font-variant-numeric: tabular-nums; }
.vote.mid { background: var(--aviso-bg); color: var(--aviso); }
.vote.low { background: var(--error-bg); color: var(--error); }
.compare { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
.legend { font-size: .78rem; color: var(--muted); margin-top: 4px; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; border: 2px solid; }
.dot.g { border-color: rgb(40,160,40); } .dot.r { border-color: rgb(220,30,30); } .dot.b { border-color: rgb(0,120,220); }
figure { margin: 0; }
figcaption { font-size: .8rem; color: var(--muted); margin-bottom: 4px; text-transform: uppercase; letter-spacing: .04em; }
.pane { background: var(--score-bg); border: 1px solid var(--border); border-radius: 6px; padding: 6px;
  display: flex; align-items: center; justify-content: center; min-height: 120px; }
.pane img, .pane svg { max-width: 100%; height: auto; max-height: 480px; }
.files a { color: var(--accent); }
.empty { text-align: center; padding: 48px 16px; }
</style>
</head>
<body>
<main>
  <h1>{{ title }}</h1>
  <div class="muted">Motor: {{ engine }} · generado {{ generated }}</div>

  <div class="stats">
    <div class="stat"><b>{{ total }}</b>compases</div>
    <div class="stat error"><b>{{ n_error }}</b>con errores</div>
    <div class="stat aviso"><b>{{ n_aviso }}</b>con avisos</div>
    <div class="stat"><b>{{ total - n_error - n_aviso }}</b>sin observaciones</div>
  </div>

  {% if infos %}
  <div class="infos"><b>Reparaciones automáticas</b>
    <ul>{% for i in infos %}<li>{{ i.message }}</li>{% endfor %}</ul>
  </div>
  {% endif %}

  <p class="files">Archivos:
    {% for name, href in files.items() %}<a href="{{ href }}">{{ name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
  </p>

  {% if cards %}
  <div class="filters" role="group" aria-label="Filtrar">
    <button data-f="doubtful" aria-pressed="true">Dudosos ({{ n_error + n_aviso }})</button>
    <button data-f="all" aria-pressed="false">Todos los compases ({{ cards|length }})</button>
    <button data-f="error" aria-pressed="false">Solo errores ({{ n_error }})</button>
    {% for rule, n in rule_counts %}
    <button data-f="rule-{{ rule }}" aria-pressed="false">{{ rule_labels.get(rule, rule) }} ({{ n }})</button>
    {% endfor %}
  </div>

  {% if n_error + n_aviso == 0 %}
  <div class="empty" id="no-doubtful"><h2>Sin compases dudosos</h2>
    <p class="muted">Todas las reglas pasaron. Pulsa «Todos los compases» para revisarlos igualmente.</p></div>
  {% endif %}
  {% for c in cards %}
  <section class="card {{ c.severity }}" data-sev="{{ c.severity }}" data-rules="{% for r in c.rules %}rule-{{ r }} {% endfor %}"{% if c.severity == 'ok' %} hidden{% endif %}>
    <header>
      <h2>{% if c.label == 'anacrusa' %}Anacrusa{% else %}Compás {{ c.label }}{% endif %}</h2>
      <span class="muted">sistema {{ c.system }}{% if c.page %} · página {{ c.page }}{% endif %}</span>
      {% if c.severity == 'ok' %}<span class="badge ok">Pasó todas las reglas</span>{% endif %}
      {% for r in c.rules %}<span class="badge {{ c.severity }}">{{ rule_labels.get(r, r) }}</span>{% endfor %}
    </header>
    {% if c.votes %}
    <div class="votes" title="Cuántas lecturas (motor × versión de la imagen) dieron exactamente la versión elegida">
      Lecturas que coinciden:
      {% for v in c.votes %}<span class="vote {% if v.ratio < 0.5 %}low{% elif v.ratio < 0.8 %}mid{% endif %}">{{ v.voice }} {{ '%g' % v.weight }}/{{ '%g' % v.total }}</span>{% endfor %}
      {% if c.similarity is not none %}<span title="Cabezas de nota de la versión elegida que coinciden con la imagen">· Coincidencia con la imagen:</span>
      <span class="vote {% if c.similarity < 0.85 %}mid{% endif %}">{{ (c.similarity * 100)|round|int }}%</span>{% endif %}
    </div>
    {% endif %}
    {% if c.issues %}
    <ul>
      {% for i in c.issues %}<li><span class="badge {{ i.severity }}">{{ i.severity }}</span> {{ i.message }}</li>{% endfor %}
    </ul>
    {% else %}
    <p class="muted">Ninguna regla encontró problemas. Aun así compáralo con el original: hay errores (por ejemplo, una nota creíble pero equivocada) que las reglas no pueden ver.</p>
    {% endif %}
    <div class="compare">
      <figure><figcaption>Original</figcaption>
        <div class="pane">{% if c.crop %}<img src="{{ c.crop }}" alt="Compás original">{% else %}<span class="muted">Sin imagen</span>{% endif %}</div>
      </figure>
      <figure><figcaption>Lo que entendió el programa</figcaption>
        <div class="pane">{{ c.svg|safe }}</div>
      </figure>
      {% if c.verif %}
      <figure><figcaption>Verificación con la imagen</figcaption>
        <div class="pane"><img src="{{ c.verif }}" alt="Verificación de cabezas de nota"></div>
        <div class="legend"><span class="dot g"></span>coincide <span class="dot r"></span>esperada y no está <span class="dot b"></span>en la imagen, sin explicar</div>
      </figure>
      {% endif %}
    </div>
  </section>
  {% endfor %}
  {% else %}
  <div class="empty"><h2>Sin compases dudosos</h2><p class="muted">Todas las reglas pasaron.</p></div>
  {% endif %}
</main>
<script>
document.querySelectorAll('.filters button').forEach(b => b.addEventListener('click', () => {
  document.querySelectorAll('.filters button').forEach(x => x.setAttribute('aria-pressed', x === b));
  const f = b.dataset.f;
  document.querySelectorAll('.card').forEach(c => {
    c.hidden = !(f === 'all'
      || (f === 'doubtful' && c.dataset.sev !== 'ok')
      || (f === 'error' && c.dataset.sev === 'error')
      || c.dataset.rules.includes(f + ' '));
  });
}));
</script>
</body>
</html>
